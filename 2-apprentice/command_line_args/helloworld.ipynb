    "import sys\n",
    "\n",
    "sys.argv = [\"helloworld.py\", \"2\"]\n",
    "\n",
    "number = 1\n",
    "# The script itself is an argument, so sys.argv will have at least one element.\n",
    "if len(sys.argv) == 2:\n",
    "    number = int(sys.argv[1])\n",
    "\n",
    "for i in range(number):\n",
    "    print(\"Hello World\")"
